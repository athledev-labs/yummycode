# yummycode is local-first. None of these are required to run with Ollama.
# Set a key only if you want to use a hosted provider (BYOK). Keys stay on your machine.

# Force a provider: auto | ollama | openai | anthropic | mock
YUMMYCODE_PROVIDER=auto

# Ollama (default local provider)
OLLAMA_HOST=http://localhost:11434
# Override the local model (otherwise the best installed model is chosen)
YUMMYCODE_OLLAMA_MODEL=

# Bring your own key (optional, hosted inference)
ANTHROPIC_API_KEY=
YUMMYCODE_ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
YUMMYCODE_OPENAI_MODEL=gpt-4o-mini

# Where the browser app is served (chosen automatically if unset)
YUMMYCODE_WEB_DIST=
